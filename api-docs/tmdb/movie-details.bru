meta {
  name: Get Movie Details
  type: http
  seq: 5
}

get {
  url: {{baseUrl}}/api/tmdb/movie/{{tmdbId}}?language={{language}}
  body: none
  auth: none
}

params:query {
  language: {{language}}
}

docs {
  # Get Movie Details

  Fetches comprehensive metadata for a movie from TMDB, automatically appending `credits`, `videos`, `watch/providers`, and `recommendations`.

  ## Path Parameters
  | Parameter | Type | Required | Description |
  | --- | --- | --- | --- |
  | `id` | `number` | Yes | Numeric TMDB movie ID. |

  ## Query Parameters
  | Parameter | Type | Required | Default | Description |
  | --- | --- | --- | --- | --- |
  | `language` | `string` | No | `en-US` | Localization language tag. |

  ## Responses
  - **200 OK**: TMDB movie details object with appended sub-resources.
  - **400 Bad Request**: `{ "error": "id must be a number" }`.
  - **500 Internal Server Error**: `{ "error": "<message>" }`.
}

