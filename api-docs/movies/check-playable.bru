meta {
  name: Check Title Playability
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/movies/{{tmdbId}}/playable?region={{region}}
  body: none
  auth: none
}

params:query {
  region: {{region}}
}

docs {
  # Check Title Playability

  Checks whether a given TMDB title ID has playable video content available in the specified region.

  ## Path Parameters
  | Parameter | Type | Required | Description |
  | --- | --- | --- | --- |
  | `tmdbId` | `number` | Yes | Numeric TMDB identifier of the title. |

  ## Query Parameters
  | Parameter | Type | Required | Default | Description |
  | --- | --- | --- | --- | --- |
  | `region` | `string` | No | `US` | ISO 3166-1 alpha-2 region code. |

  ## Responses
  - **200 OK**: `{ "playable": true }` or `{ "playable": false }`.
  - **400 Bad Request**: `{ "error": "tmdbId must be a number" }`.
  - **500 Internal Server Error**: `{ "error": "<message>" }`.
}

