meta {
  name: Get My Profile
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/profile/me
  body: none
  auth: none
}

docs {
  # Get Authenticated User Profile

  Returns the profile record for the currently authenticated user (`GET /api/profile/me`).
  Requires authentication (`authMiddleware`).

  ## Responses
  - **200 OK**:
    ```json
    {
      "id": "user_123",
      "displayName": "Jane Doe",
      "avatarUrl": null,
      "plan": null,
      "memberSince": null,
      "region": "US",
      "language": "en-US",
      "maturityRating": "TV-MA",
      "isKids": false,
      "regionSource": null
    }
    ```
  - **401 Unauthorized**: `{ "error": "Unauthorized" }`.
  - **404 Not Found**: `{ "error": "Profile not found" }`.
  - **500 Internal Server Error**: `{ "error": "<message>" }`.
}

