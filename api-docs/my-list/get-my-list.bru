  seq: 1
}

get {
  url: {{baseUrl}}/api/my-list
  body: none
  auth: none
}

docs {
  # Get My List

  Returns all items saved in the authenticated user's personal list (`my_list`), ordered chronologically by `addedAt`.
  Requires authentication (`authMiddleware`).

  ## Responses
  - **200 OK**:
    ```json
    [
      {
        "id": 1,
        "profileId": "user_123",
        "tmdbId": 157336,
        "mediaType": "movie",
        "addedAt": "2026-10-18T18:00:00.000Z"
      }
    ]
    ```
  - **401 Unauthorized**: `{ "error": "Unauthorized" }`.
  - **500 Internal Server Error**: `{ "error": "<message>" }`.
}

