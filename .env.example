# Server
PORT=3000
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:3000

DATABASE_URL="postgresql://neondb_owner:password@ep-example-123456.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Authentication (Better Auth)
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-a-32-byte-secret
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:5173,http://localhost:3000

# TMDB Integration
TMDB_BASE_URL=https://api.themoviedb.org/3
TMDB_IMAGE_BASE_URL=https://image.tmdb.org/t/p
TMDB_API_KEY=your-tmdb-api-key
TMDB_READ_ACCESS_TOKEN=your-tmdb-read-access-token

# Mux Integration
MUX_TOKEN_ID=your-mux-token-id
MUX_TOKEN_SECRET=your-mux-token-secret
PUBLIC_MUX_PLAYBACK_DOMAIN=stream.mux.com

# S3-compatible storage. Generate a credential to fill in the key ID + secret.
AWS_ENDPOINT_URL_S3="xxxx"
AWS_ACCESS_KEY_ID="xxxxx"
AWS_SECRET_ACCESS_KEY="xxxxx"
AWS_REGION="us-east-2"

# Avatar uploads (Neon Object Storage bucket, must be `public_read`)
AVATARS_BUCKET="avatars"
# Optional. Defaults to <AWS_ENDPOINT_URL_S3>/<AVATARS_BUCKET>
# AVATARS_PUBLIC_BASE_URL=""
